    "半径%dm以内で死亡事故が%d件発生しています。交差点進入時や横断歩道手前での一時停止・減速を徹底してください。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半径%dm以内で死亡事故が%d件発生しています。交差点進入時や横断歩道手前での一時停止・減速を徹底してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$d fatal accident(s) occurred within %1$dm. Slow down and stop carefully before intersections and crosswalks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半径%d米内发生过%d起死亡事故。进入路口或人行横道前请务必减速停车确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半徑%d公尺內發生過%d起死亡事故。進入路口或行人穿越道前請務必減速停車確認。"
          }
        }
      }
    },
    "半径%dm以内の公式事故記録は僅少ですが、引き続き安全運転を心がけてください。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半径%dm以内の公式事故記録は僅少ですが、引き続き安全運転を心がけてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Few official accident records within %dm, but please continue driving safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半径%d米内官方事故记录较少，但仍请继续保持安全驾驶。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半徑%d公尺內官方事故記錄較少，但仍請繼續保持安全駕駛。"
          }
        }
      }
    },
